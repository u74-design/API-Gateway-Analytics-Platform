# Public URL of this backend; do not include a trailing slash.
BASE_URL=https://api.example.com
PORT=5000

# Secrets: use separate, long random values in the hosting provider's secret store.
MONGO_URI=mongodb+srv://...
JWT_SECRET=replace-with-a-64-character-random-secret
API_KEY_PEPPER=replace-with-a-different-64-character-random-secret
REDIS_URL=rediss://default:...@...

# Comma-separated browser app origins. Leave unset only for non-browser clients.
FRONTEND_ORIGINS=https://app.example.com
# Set true only when deployed behind one known reverse proxy/load balancer.
TRUST_PROXY=true
UPSTREAM_TIMEOUT_MS=10000
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPSTREAM_RESPONSE_BYTES=10485760
